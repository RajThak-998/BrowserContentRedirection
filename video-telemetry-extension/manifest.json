{
  "manifest_version": 3,
  "name": "BCR Video Telemetry",
  "version": "0.1.0",
  "description": "Detects and suppresses the primary video element; forwards all MSE chunks to the BCR WebRTC pipeline.",

  "permissions": [
    "activeTab",
    "scripting"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "service_worker": "background/background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "run_at": "document_start",
      "world": "MAIN",
      "js": [
        "content/pageInterceptor.js"
      ]
    },
    {
      "matches": ["<all_urls>"],
      "run_at": "document_start",
      "js": [
        "utils/throttle.js",
        "content/stateManager.js",
        "content/emitter.js",
        "content/observers.js",
        "content/overlayRenderer.js",
        "content/videoTracker.js",
        "content/videoRegistry.js",
        "content/bootstrap.js"
      ]
    }
  ]
}