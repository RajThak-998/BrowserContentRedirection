{
  "manifest_version": 3,
  "name": "BCR Video Telemetry",
  "version": "0.1.0",
  "description": "Phase 1 — Detects and tracks video elements, emits position and state telemetry to a local endpoint.",

  "permissions": [
    "activeTab",
    "scripting"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "service_worker": "background/background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "run_at": "document_start",
      "js": [
        "utils/throttle.js",
        "content/stateManager.js",
        "content/emitter.js",
        "content/observers.js",
        "content/overlayRenderer.js",
        "content/videoTracker.js",
        "content/videoRegistry.js",
        "content/bootstrap.js"
      ]
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["content/pageInterceptor.js"],
      "matches": ["<all_urls>"]
    }
  ]
}